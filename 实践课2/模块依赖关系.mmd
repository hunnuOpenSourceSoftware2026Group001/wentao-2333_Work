flowchart BT
  subgraph L1[基础能力与协议]
    telemetry[telemetry]
    schema[schema]
    tui[tui]
    codemode[codemode]
    mcp[mcp]
  end
  subgraph L2[复合库]
    chord[chord]
    ai[ai]
  end
  subgraph L3[运行时能力]
    durable[durable]
    env[env]
    agent[agent]
  end
  subgraph L4[应用产品]
    codingAgent[coding-agent]
  end
  chord --> schema
  chord --> telemetry
  ai --> schema
  ai --> telemetry
  durable --> chord
  durable --> ai
  durable --> codemode
  durable --> schema
  durable --> telemetry
  env --> chord
  env --> durable
  agent --> ai
  agent --> schema
  codingAgent --> agent
  codingAgent --> ai
  codingAgent --> codemode
  codingAgent --> mcp
  codingAgent --> tui

  %% 箭头统一表示“使用方 --> 被依赖方”；仅绘制 package.json 中可核实的直接运行时依赖（dependencies）。
  %% chord 的 esbuild/react/ws 为可选 peerDependencies，不是这 11 个模块之间的内部运行时依赖，故不绘制。
